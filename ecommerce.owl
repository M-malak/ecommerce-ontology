    <ec:hasDescription xml:lang="en">Consumer electronics brand specialising in charging technology and mobile accessories.</ec:hasDescription>
  </owl:NamedIndividual>

  <owl:AllDifferent>
    <owl:distinctMembers rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Apple"/>
      <rdf:Description rdf:about="&ec;Samsung"/>
      <rdf:Description rdf:about="&ec;Asus"/>
      <rdf:Description rdf:about="&ec;Sony"/>
      <rdf:Description rdf:about="&ec;Anker"/>
    </owl:distinctMembers>
  </owl:AllDifferent>

