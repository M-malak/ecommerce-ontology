<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/ecommerce#"
     xml:base="http://www.example.org/ecommerce"
     xmlns:ec="http://www.example.org/ecommerce#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

  <owl:Ontology rdf:about="http://www.example.org/ecommerce">
    <rdfs:label>E-Commerce Product Ontology v2.0</rdfs:label>
    <rdfs:comment>OWL 2 DL ontology for online shopping platform.</rdfs:comment>
  </owl:Ontology>

  <!-- OBJECT PROPERTIES -->
  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#purchases">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://www.example.org/ecommerce#Product"/>
    <owl:inverseOf rdf:resource="http://www.example.org/ecommerce#isPurchasedBy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#isPurchasedBy"/>

  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#manufacturedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://www.example.org/ecommerce#Brand"/>
    <owl:inverseOf rdf:resource="http://www.example.org/ecommerce#manufactures"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#manufactures"/>

  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#placesOrder">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://www.example.org/ecommerce#Order"/>
    <owl:inverseOf rdf:resource="http://www.example.org/ecommerce#isOrderOf"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#isOrderOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#containsProduct">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Order"/>
    <rdfs:range rdf:resource="http://www.example.org/ecommerce#Product"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#usesPaymentMethod">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Order"/>
    <rdfs:range rdf:resource="http://www.example.org/ecommerce#PaymentMethod"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#reviewsProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Review"/>
    <rdfs:range rdf:resource="http://www.example.org/ecommerce#Product"/>
    <owl:inverseOf rdf:resource="http://www.example.org/ecommerce#hasReview"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#hasReview"/>

  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#prefersBrand">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://www.example.org/ecommerce#Brand"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.example.org/ecommerce#purchases"/>
      <rdf:Description rdf:about="http://www.example.org/ecommerce#manufacturedBy"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.example.org/ecommerce#hasSubcategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  </owl:ObjectProperty>

  <!-- DATA PROPERTIES -->
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasPrice">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasDiscountPercentage">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasAggregateRating">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#isGamingLaptop">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Laptop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasOrderCount">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#isVerifiedPurchase">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Review"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasRating">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Review"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasSKU">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasOrderID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Order"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasDeliveryStatus">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Order"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/ecommerce#hasTotalAmount">
    <rdfs:domain rdf:resource="http://www.example.org/ecommerce#Order"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <!-- CLASSES -->
  <owl:Class rdf:about="http://www.example.org/ecommerce#Brand"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Category"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Customer"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Seller"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Review"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Order"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#PaymentMethod"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#CreditCard"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#PaymentMethod"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#PayPal"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#PaymentMethod"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#BankTransfer"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#PaymentMethod"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#CryptoCurrency"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#PaymentMethod"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Product"/>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Electronics"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Product"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Accessories"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Product"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Laptop"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Electronics"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Smartphone"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Electronics"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Tablet"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Electronics"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Headphones"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Electronics"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#SmartWatch"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Electronics"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Cable"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Accessories"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Charger"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Accessories"/></owl:Class>
  <owl:Class rdf:about="http://www.example.org/ecommerce#Case"><rdfs:subClassOf rdf:resource="http://www.example.org/ecommerce#Accessories"/></owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.example.org/ecommerce#Customer"/>
      <rdf:Description rdf:about="http://www.example.org/ecommerce#Seller"/>
      <rdf:Description rdf:about="http://www.example.org/ecommerce#Brand"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.example.org/ecommerce#Electronics"/>
      <rdf:Description rdf:about="http://www.example.org/ecommerce#Accessories"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- DEFINED CLASSES (reasoner infers these) -->
  <owl:Class rdf:about="http://www.example.org/ecommerce#PremiumProduct">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#hasPrice"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1000.0</xsd:minInclusive></rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#BudgetProduct">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#hasPrice"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description><xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</xsd:maxExclusive></rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#DiscountedProduct">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#hasDiscountPercentage"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description><xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minExclusive></rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#HighRatedProduct">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#hasAggregateRating"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.5</xsd:minInclusive></rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#GamingLaptop">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Laptop"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#isGamingLaptop"/>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#GamerCustomer">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Customer"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#purchases"/>
            <owl:someValuesFrom rdf:resource="http://www.example.org/ecommerce#GamingLaptop"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#FrequentBuyer">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Customer"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#hasOrderCount"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</xsd:minInclusive></rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#LoyalCustomer">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#FrequentBuyer"/>
          <rdf:Description rdf:about="http://www.example.org/ecommerce#GamerCustomer"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="http://www.example.org/ecommerce#VerifiedReview">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/ecommerce#Review"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.example.org/ecommerce#isVerifiedPurchase"/>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- BRANDS -->
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#Apple"><rdf:type rdf:resource="http://www.example.org/ecommerce#Brand"/><rdfs:label>Apple Inc.</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#Samsung"><rdf:type rdf:resource="http://www.example.org/ecommerce#Brand"/><rdfs:label>Samsung</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#Asus"><rdf:type rdf:resource="http://www.example.org/ecommerce#Brand"/><rdfs:label>Asus</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#Sony"><rdf:type rdf:resource="http://www.example.org/ecommerce#Brand"/><rdfs:label>Sony</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#Anker"><rdf:type rdf:resource="http://www.example.org/ecommerce#Brand"/><rdfs:label>Anker</rdfs:label></owl:NamedIndividual>

  <!-- PRODUCTS -->
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#MacBookPro">
    <rdf:type rdf:resource="http://www.example.org/ecommerce#Laptop"/>
    <rdfs:label>MacBook Pro M3 Max</rdfs:label>
    <ec:hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2499.00</ec:hasPrice>
    <ec:hasDiscountPercentage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</ec:hasDiscountPercentage>
    <ec:hasAggregateRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.9</ec:hasAggregateRating>
    <ec:isGamingLaptop rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ec:isGamingLaptop>
    <ec:manufacturedBy rdf:resource="http://www.example.org/ecommerce#Apple"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#iPhone15Pro">
    <rdf:type rdf:resource="http://www.example.org/ecommerce#Smartphone"/>
    <rdfs:label>iPhone 15 Pro</rdfs:label>
    <ec:hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1199.00</ec:hasPrice>
    <ec:hasDiscountPercentage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</ec:hasDiscountPercentage>
    <ec:hasAggregateRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.8</ec:hasAggregateRating>
    <ec:manufacturedBy rdf:resource="http://www.example.org/ecommerce#Apple"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#GalaxyS24Ultra">
    <rdf:type rdf:resource="http://www.example.org/ecommerce#Smartphone"/>
    <rdfs:label>Galaxy S24 Ultra</rdfs:label>
    <ec:hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">899.00</ec:hasPrice>
    <ec:hasDiscountPercentage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</ec:hasDiscountPercentage>
    <ec:hasAggregateRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.6</ec:hasAggregateRating>
    <ec:manufacturedBy rdf:resource="http://www.example.org/ecommerce#Samsung"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#ROGZephyrus">
    <rdf:type rdf:resource="http://www.example.org/ecommerce#Laptop"/>
    <rdfs:label>ROG Zephyrus G16</rdfs:label>
    <ec:hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1799.00</ec:hasPrice>
    <ec:hasDiscountPercentage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</ec:hasDiscountPercentage>
    <ec:hasAggregateRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.8</ec:hasAggregateRating>
    <ec:isGamingLaptop rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ec:isGamingLaptop>
    <ec:manufacturedBy rdf:resource="http://www.example.org/ecommerce#Asus"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#SonyHeadphones">
    <rdf:type rdf:resource="http://www.example.org/ecommerce#Headphones"/>
    <rdfs:label>Sony WH-1000XM5</rdfs:label>
    <ec:hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">349.00</ec:hasPrice>
    <ec:hasDiscountPercentage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.5</ec:hasDiscountPercentage>
    <ec:hasAggregateRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.7</ec:hasAggregateRating>
    <ec:manufacturedBy rdf:resource="http://www.example.org/ecommerce#Sony"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.example.org/ecommerce#AnkerCharger">
    <rdf:type rdf:resource="http://www.example.org/ecommerce#Charger"/>
    <rdfs:label>Anker 67W Charger</rdfs:label>
    <ec:hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">55.00</ec:hasPrice>
    <ec:hasDiscountPercentage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</ec:hasDiscountPercentage>
    <ec:hasAggregateRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.6</ec:hasAggregateRating>
    <ec:manufacturedBy rdf:resource="http://www.example.org/ecommerce#Anker"/>
  </owl:NamedIndividual>

  <owl:AllDifferent><owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="http://www.example.org/ecommerce#MacBookPro"/>
    <rdf:Description rdf:about="http://www.example.org/ecommerce#iPhone15Pro"/>
    <rdf:Description rdf:about="http://www.example.org/ecommerce#GalaxyS24Ultra"/>
