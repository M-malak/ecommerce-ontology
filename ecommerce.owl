<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl  "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd  "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf  "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY dc   "http://purl.org/dc/elements/1.1/" >
    <!ENTITY skos "http://www.w3.org/2004/02/skos/core#" >
    <!ENTITY ec   "http://www.example.org/ecommerce#" >
]>

<!--
  ================================================================
  E-Commerce Product Ontology  |  OWL 2 DL  |  Version 2.0
  IRI: http://www.example.org/ecommerce
  Author: Mohd Khan - University of Campania Luigi Vanvitelli
  Reasoner: HermiT 1.4 / Pellet 2.x (Protege 5.6 Desktop)
  ================================================================
-->

<rdf:RDF
    xmlns:owl ="http://www.w3.org/2002/07/owl#"
    xmlns:xsd ="http://www.w3.org/2001/XMLSchema#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:rdf ="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:dc  ="http://purl.org/dc/elements/1.1/"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:ec  ="http://www.example.org/ecommerce#"
    xml:base  ="http://www.example.org/ecommerce">

  <!-- ============================================================
       ONTOLOGY HEADER
       ============================================================ -->
  <owl:Ontology rdf:about="http://www.example.org/ecommerce">
    <owl:versionIRI rdf:resource="http://www.example.org/ecommerce/2.0"/>
    <owl:versionInfo rdf:datatype="&xsd;string">2.0.0</owl:versionInfo>
    <rdfs:label xml:lang="en">E-Commerce Product Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">OWL 2 DL ontology modelling the core domain of an online shopping platform. Covers product catalogues, customer and seller roles, order lifecycle, brand and category taxonomy, user-generated reviews, and payment methods. Provides automated classification of PremiumProduct, BudgetProduct, MidRangeProduct, GamingLaptop, GamerCustomer, FrequentBuyer, HighRatedProduct, LoyalCustomer, DiscountedProduct, and VerifiedReview via HermiT/Pellet reasoning.</rdfs:comment>
    <dc:creator>Mohd Khan</dc:creator>
    <dc:publisher>University of Campania Luigi Vanvitelli</dc:publisher>
    <dc:date rdf:datatype="&xsd;date">2026-05-09</dc:date>
    <dc:description xml:lang="en">An expressive e-commerce knowledge graph ontology demonstrating OWL 2 DL: qualified cardinality restrictions, equivalent-class definitions, inverse properties, property chains, asymmetric and transitive properties, SKOS annotations, and comprehensive disjointness constraints.</dc:description>
    <dc:rights>MIT License</dc:rights>
  </owl:Ontology>

  <!-- ============================================================
       ANNOTATION PROPERTIES
       ============================================================ -->
  <owl:AnnotationProperty rdf:about="&dc;creator"/>
  <owl:AnnotationProperty rdf:about="&dc;publisher"/>
  <owl:AnnotationProperty rdf:about="&dc;date"/>
  <owl:AnnotationProperty rdf:about="&dc;description"/>
  <owl:AnnotationProperty rdf:about="&dc;rights"/>
  <owl:AnnotationProperty rdf:about="&skos;definition"/>
  <owl:AnnotationProperty rdf:about="&skos;example"/>
  <owl:AnnotationProperty rdf:about="&skos;note"/>
  <owl:AnnotationProperty rdf:about="&skos;altLabel"/>

  <owl:AnnotationProperty rdf:about="&ec;answersCompetencyQuestion">
    <rdfs:label xml:lang="en">answers competency question</rdfs:label>
    <rdfs:comment xml:lang="en">Links an ontology element to the competency question it answers.</rdfs:comment>
  </owl:AnnotationProperty>

  <owl:AnnotationProperty rdf:about="&ec;encodesBusinessRule">
    <rdfs:label xml:lang="en">encodes business rule</rdfs:label>
    <rdfs:comment xml:lang="en">Links an axiom to the business rule it formally represents.</rdfs:comment>
  </owl:AnnotationProperty>

  <!-- ============================================================
       DATA PROPERTIES
       ============================================================ -->

  <owl:DatatypeProperty rdf:about="&ec;hasPrice">
    <rdfs:label xml:lang="en">has price</rdfs:label>
    <skos:definition xml:lang="en">Retail price of a product in USD (non-negative decimal).</skos:definition>
    <ec:answersCompetencyQuestion>CQ1: Which products cost more than $1000?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasOriginalPrice">
    <rdfs:label xml:lang="en">has original price</rdfs:label>
    <skos:definition xml:lang="en">List price before any discount is applied.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasDiscountPercentage">
    <rdfs:label xml:lang="en">has discount percentage</rdfs:label>
    <skos:definition xml:lang="en">Percentage discount applied to the product (0-100).</skos:definition>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasStockQuantity">
    <rdfs:label xml:lang="en">has stock quantity</rdfs:label>
    <skos:definition xml:lang="en">Units currently available in warehouse inventory.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;nonNegativeInteger"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasSKU">
    <rdfs:label xml:lang="en">has SKU</rdfs:label>
    <skos:definition xml:lang="en">Stock Keeping Unit - unique alphanumeric product identifier.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;string"/>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasWeight">
    <rdfs:label xml:lang="en">has weight kg</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasDescription">
    <rdfs:label xml:lang="en">has description</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasRating">
    <rdfs:label xml:lang="en">has rating</rdfs:label>
    <skos:definition xml:lang="en">Numeric rating 0.0-5.0 assigned by a customer review.</skos:definition>
    <ec:answersCompetencyQuestion>CQ9: Which reviews rate a product above 4.5?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Review"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasAggregateRating">
    <rdfs:label xml:lang="en">has aggregate rating</rdfs:label>
    <skos:definition xml:lang="en">Mean of all customer review ratings for a product (0.0-5.0).</skos:definition>
    <ec:answersCompetencyQuestion>CQ10: Which products have aggregate rating above 4.5?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasCustomerID">
    <rdfs:label xml:lang="en">has customer ID</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&xsd;string"/>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasSellerID">
    <rdfs:label xml:lang="en">has seller ID</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Seller"/>
    <rdfs:range rdf:resource="&xsd;string"/>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasEmail">
    <rdfs:label xml:lang="en">has email</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasPhoneNumber">
    <rdfs:label xml:lang="en">has phone number</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasAddress">
    <rdfs:label xml:lang="en">has address</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasName">
    <rdfs:label xml:lang="en">has name</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasOrderID">
    <rdfs:label xml:lang="en">has order ID</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Order"/>
    <rdfs:range rdf:resource="&xsd;string"/>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasOrderDate">
    <rdfs:label xml:lang="en">has order date</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Order"/>
    <rdfs:range rdf:resource="&xsd;date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasTotalAmount">
    <rdfs:label xml:lang="en">has total amount</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Order"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasDeliveryStatus">
    <rdfs:label xml:lang="en">has delivery status</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Order"/>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasReviewText">
    <rdfs:label xml:lang="en">has review text</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Review"/>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;isVerifiedPurchase">
    <rdfs:label xml:lang="en">is verified purchase</rdfs:label>
    <skos:definition xml:lang="en">True when the review author purchased the product through the platform.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Review"/>
    <rdfs:range rdf:resource="&xsd;boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;isGamingLaptop">
    <rdfs:label xml:lang="en">is gaming laptop</rdfs:label>
    <skos:definition xml:lang="en">Boolean flag; true when a laptop is positioned as a gaming device.</skos:definition>
    <ec:encodesBusinessRule>Drives automated GamingLaptop and GamerCustomer classification.</ec:encodesBusinessRule>
    <rdfs:domain rdf:resource="&ec;Laptop"/>
    <rdfs:range rdf:resource="&xsd;boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasOrderCount">
    <rdfs:label xml:lang="en">has order count</rdfs:label>
    <skos:definition xml:lang="en">Total number of orders placed by a customer.</skos:definition>
    <ec:answersCompetencyQuestion>CQ11: Which customers have placed 3 or more orders?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&xsd;nonNegativeInteger"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasFoundedYear">
    <rdfs:label xml:lang="en">has founded year</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Brand"/>
    <rdfs:range rdf:resource="&xsd;gYear"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasCountryOfOrigin">
    <rdfs:label xml:lang="en">has country of origin</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Brand"/>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <!-- ============================================================
       OBJECT PROPERTIES
       ============================================================ -->

  <!-- purchases / isPurchasedBy -->
  <owl:ObjectProperty rdf:about="&ec;purchases">
    <rdfs:label xml:lang="en">purchases</rdfs:label>
    <skos:definition xml:lang="en">Customer bought a Product. Inverse of isPurchasedBy.</skos:definition>
    <ec:answersCompetencyQuestion>CQ2, CQ8</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&ec;Product"/>
    <owl:inverseOf rdf:resource="&ec;isPurchasedBy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;isPurchasedBy">
    <rdfs:label xml:lang="en">is purchased by</rdfs:label>
    <owl:inverseOf rdf:resource="&ec;purchases"/>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&ec;Customer"/>
  </owl:ObjectProperty>

  <!-- placesOrder / isOrderOf -->
  <owl:ObjectProperty rdf:about="&ec;placesOrder">
    <rdfs:label xml:lang="en">places order</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&ec;Order"/>
    <owl:inverseOf rdf:resource="&ec;isOrderOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;isOrderOf">
    <rdfs:label xml:lang="en">is order of</rdfs:label>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
    <owl:inverseOf rdf:resource="&ec;placesOrder"/>
    <rdfs:domain rdf:resource="&ec;Order"/>
    <rdfs:range rdf:resource="&ec;Customer"/>
  </owl:ObjectProperty>

  <!-- containsProduct -->
  <owl:ObjectProperty rdf:about="&ec;containsProduct">
    <rdfs:label xml:lang="en">contains product</rdfs:label>
    <skos:definition xml:lang="en">Order includes a Product. An Order must contain at least one Product.</skos:definition>
    <ec:encodesBusinessRule>minQualifiedCardinality 1 on Order forces at least one product per order.</ec:encodesBusinessRule>
    <rdfs:domain rdf:resource="&ec;Order"/>
    <rdfs:range rdf:resource="&ec;Product"/>
  </owl:ObjectProperty>

  <!-- manufacturedBy / manufactures -->
  <owl:ObjectProperty rdf:about="&ec;manufacturedBy">
    <rdfs:label xml:lang="en">manufactured by</rdfs:label>
    <skos:definition xml:lang="en">Product has exactly one manufacturing Brand. Functional and asymmetric.</skos:definition>
    <ec:encodesBusinessRule>Every Product has exactly 1 Brand.</ec:encodesBusinessRule>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&ec;Brand"/>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
    <rdf:type rdf:resource="&owl;AsymmetricProperty"/>
    <owl:inverseOf rdf:resource="&ec;manufactures"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;manufactures">
    <rdfs:label xml:lang="en">manufactures</rdfs:label>
    <owl:inverseOf rdf:resource="&ec;manufacturedBy"/>
    <rdfs:domain rdf:resource="&ec;Brand"/>
    <rdfs:range rdf:resource="&ec;Product"/>
  </owl:ObjectProperty>

  <!-- belongsToCategory / hasMember -->
  <owl:ObjectProperty rdf:about="&ec;belongsToCategory">
    <rdfs:label xml:lang="en">belongs to category</rdfs:label>
    <ec:answersCompetencyQuestion>CQ7: Which products belong to Gaming?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&ec;Category"/>
    <owl:inverseOf rdf:resource="&ec;hasMember"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;hasMember">
    <rdfs:label xml:lang="en">has member</rdfs:label>
    <owl:inverseOf rdf:resource="&ec;belongsToCategory"/>
    <rdfs:domain rdf:resource="&ec;Category"/>
    <rdfs:range rdf:resource="&ec;Product"/>
  </owl:ObjectProperty>

  <!-- hasSubcategory - Transitive, Asymmetric, Irreflexive -->
  <owl:ObjectProperty rdf:about="&ec;hasSubcategory">
    <rdfs:label xml:lang="en">has subcategory</rdfs:label>
    <skos:definition xml:lang="en">Transitive hierarchical relation between category nodes.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Category"/>
    <rdfs:range rdf:resource="&ec;Category"/>
    <rdf:type rdf:resource="&owl;TransitiveProperty"/>
    <rdf:type rdf:resource="&owl;AsymmetricProperty"/>
    <rdf:type rdf:resource="&owl;IrreflexiveProperty"/>
  </owl:ObjectProperty>

  <!-- writesReview / isWrittenBy -->
  <owl:ObjectProperty rdf:about="&ec;writesReview">
    <rdfs:label xml:lang="en">writes review</rdfs:label>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&ec;Review"/>
    <owl:inverseOf rdf:resource="&ec;isWrittenBy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;isWrittenBy">
    <rdfs:label xml:lang="en">is written by</rdfs:label>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
    <owl:inverseOf rdf:resource="&ec;writesReview"/>
    <rdfs:domain rdf:resource="&ec;Review"/>
    <rdfs:range rdf:resource="&ec;Customer"/>
  </owl:ObjectProperty>

  <!-- reviewsProduct / hasReview -->
  <owl:ObjectProperty rdf:about="&ec;reviewsProduct">
    <rdfs:label xml:lang="en">reviews product</rdfs:label>
    <ec:answersCompetencyQuestion>CQ6: What reviews exist for ROGZephyrus?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Review"/>
    <rdfs:range rdf:resource="&ec;Product"/>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
    <owl:inverseOf rdf:resource="&ec;hasReview"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;hasReview">
    <rdfs:label xml:lang="en">has review</rdfs:label>
    <owl:inverseOf rdf:resource="&ec;reviewsProduct"/>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&ec;Review"/>
  </owl:ObjectProperty>

  <!-- sells / isSoldBy -->
  <owl:ObjectProperty rdf:about="&ec;sells">
    <rdfs:label xml:lang="en">sells</rdfs:label>
    <ec:answersCompetencyQuestion>CQ8: Which sellers list premium products?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Seller"/>
    <rdfs:range rdf:resource="&ec;Product"/>
    <owl:inverseOf rdf:resource="&ec;isSoldBy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;isSoldBy">
    <rdfs:label xml:lang="en">is sold by</rdfs:label>
    <owl:inverseOf rdf:resource="&ec;sells"/>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&ec;Seller"/>
  </owl:ObjectProperty>

  <!-- usesPaymentMethod -->
  <owl:ObjectProperty rdf:about="&ec;usesPaymentMethod">
    <rdfs:label xml:lang="en">uses payment method</rdfs:label>
    <ec:answersCompetencyQuestion>CQ5: Which orders used PayPal?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Order"/>
    <rdfs:range rdf:resource="&ec;PaymentMethod"/>
  </owl:ObjectProperty>

  <!-- prefersBrand - inferred via property chain -->
  <owl:ObjectProperty rdf:about="&ec;prefersBrand">
    <rdfs:label xml:lang="en">prefers brand</rdfs:label>
    <skos:definition xml:lang="en">Inferred property. If a Customer purchases a Product manufactured by a Brand, the reasoner infers the Customer prefersBrand that Brand.</skos:definition>
    <skos:note xml:lang="en">Property chain: purchases o manufacturedBy SubPropertyOf prefersBrand</skos:note>
    <ec:answersCompetencyQuestion>CQ12: Which brands does a customer prefer based on purchase history?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&ec;Brand"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;purchases"/>
      <rdf:Description rdf:about="&ec;manufacturedBy"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>

  <!-- hasRelatedProduct - Symmetric, Irreflexive -->
  <owl:ObjectProperty rdf:about="&ec;hasRelatedProduct">
    <rdfs:label xml:lang="en">has related product</rdfs:label>
    <skos:definition xml:lang="en">Symmetric relation between products commonly purchased together or from the same product family.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&ec;Product"/>
    <rdf:type rdf:resource="&owl;SymmetricProperty"/>
    <rdf:type rdf:resource="&owl;IrreflexiveProperty"/>
  </owl:ObjectProperty>


  <!-- ============================================================
       CORE CLASSES
       ============================================================ -->

  <owl:Class rdf:about="&ec;Brand">
    <rdfs:label xml:lang="en">Brand</rdfs:label>
    <skos:definition xml:lang="en">A commercial entity that manufactures and markets products.</skos:definition>
    <skos:example xml:lang="en">Apple Inc., Samsung Electronics, ASUSTeK</skos:example>
  </owl:Class>

  <owl:Class rdf:about="&ec;Category">
    <rdfs:label xml:lang="en">Category</rdfs:label>
    <skos:definition xml:lang="en">A node in the product taxonomy tree; categories can have subcategories (transitive hasSubcategory).</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="&ec;PaymentMethod">
    <rdfs:label xml:lang="en">PaymentMethod</rdfs:label>
    <skos:definition xml:lang="en">A mechanism for settling the financial obligation of an Order.</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;CreditCard"/>
          <rdf:Description rdf:about="&ec;PayPal"/>
          <rdf:Description rdf:about="&ec;BankTransfer"/>
          <rdf:Description rdf:about="&ec;CryptoCurrency"/>
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <owl:Class rdf:about="&ec;CreditCard">
    <rdfs:label xml:lang="en">CreditCard</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ec;PaymentMethod"/>
    <skos:definition xml:lang="en">Payment via Visa, Mastercard, or AMEX card.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="&ec;PayPal">
    <rdfs:label xml:lang="en">PayPal</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ec;PaymentMethod"/>
    <skos:definition xml:lang="en">Digital wallet payment via the PayPal platform.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="&ec;BankTransfer">
    <rdfs:label xml:lang="en">BankTransfer</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ec;PaymentMethod"/>
    <skos:definition xml:lang="en">Direct bank-to-bank transfer such as SEPA or wire transfer.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="&ec;CryptoCurrency">
    <rdfs:label xml:lang="en">CryptoCurrency</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ec;PaymentMethod"/>
    <skos:definition xml:lang="en">Payment via blockchain-based digital currency (Bitcoin, Ethereum).</skos:definition>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;CreditCard"/>
      <rdf:Description rdf:about="&ec;PayPal"/>
      <rdf:Description rdf:about="&ec;BankTransfer"/>
      <rdf:Description rdf:about="&ec;CryptoCurrency"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- Review - with cardinality restrictions -->
  <owl:Class rdf:about="&ec;Review">
    <rdfs:label xml:lang="en">Review</rdfs:label>
    <skos:definition xml:lang="en">Customer-authored evaluation of a product with numeric rating and optional free text.</skos:definition>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;reviewsProduct"/>
        <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="&ec;Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;hasRating"/>
        <owl:cardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="&ec;Customer">
    <rdfs:label xml:lang="en">Customer</rdfs:label>
    <skos:definition xml:lang="en">A registered user who purchases products, places orders, and authors reviews.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="&ec;Seller">
    <rdfs:label xml:lang="en">Seller</rdfs:label>
    <skos:definition xml:lang="en">An individual or business listing products for sale on the platform.</skos:definition>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Customer"/>
      <rdf:Description rdf:about="&ec;Seller"/>
      <rdf:Description rdf:about="&ec;Brand"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- Order - three restrictions -->
  <owl:Class rdf:about="&ec;Order">
    <rdfs:label xml:lang="en">Order</rdfs:label>
    <skos:definition xml:lang="en">A transaction record linking a customer to one or more purchased products and a payment method.</skos:definition>
    <ec:encodesBusinessRule>An Order must contain at least one Product - empty orders are inadmissible.</ec:encodesBusinessRule>
    <!-- RESTRICTION 1: at least 1 Product -->
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;containsProduct"/>
        <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="&ec;Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <!-- RESTRICTION 2: exactly 1 PaymentMethod -->
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;usesPaymentMethod"/>
        <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="&ec;PaymentMethod"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <!-- RESTRICTION 3: exactly 1 Customer -->
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;isOrderOf"/>
        <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="&ec;Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- Product - four restrictions -->
  <owl:Class rdf:about="&ec;Product">
    <rdfs:label xml:lang="en">Product</rdfs:label>
    <skos:definition xml:lang="en">Any tangible or digital item offered for sale through the platform.</skos:definition>
    <!-- RESTRICTION 4: exactly 1 Brand -->
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;manufacturedBy"/>
        <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="&ec;Brand"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <!-- RESTRICTION 5: at least 1 price -->
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;hasPrice"/>
        <owl:minCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <!-- RESTRICTION 6: at least 1 Category -->
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="&ec;belongsToCategory"/>
        <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="&ec;Category"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- ============================================================
       PRODUCT SUBCLASSES
       ============================================================ -->

  <owl:Class rdf:about="&ec;Electronics">
    <rdfs:label xml:lang="en">Electronics</rdfs:label>
    <skos:definition xml:lang="en">Electronic devices requiring power to operate.</skos:definition>
    <rdfs:subClassOf rdf:resource="&ec;Product"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Laptop">
    <rdfs:label xml:lang="en">Laptop</rdfs:label>
    <skos:definition xml:lang="en">A portable personal computer with integrated keyboard and display.</skos:definition>
    <rdfs:subClassOf rdf:resource="&ec;Electronics"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Smartphone">
    <rdfs:label xml:lang="en">Smartphone</rdfs:label>
    <skos:definition xml:lang="en">A handheld mobile device combining telephony, computing, and internet access.</skos:definition>
    <rdfs:subClassOf rdf:resource="&ec;Electronics"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Tablet">
    <rdfs:label xml:lang="en">Tablet</rdfs:label>
    <skos:definition xml:lang="en">A portable touchscreen computing device between a smartphone and a laptop.</skos:definition>
    <rdfs:subClassOf rdf:resource="&ec;Electronics"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Headphones">
    <rdfs:label xml:lang="en">Headphones</rdfs:label>
    <skos:definition xml:lang="en">Personal audio devices worn on or around the ears.</skos:definition>
    <rdfs:subClassOf rdf:resource="&ec;Electronics"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;SmartWatch">
    <rdfs:label xml:lang="en">SmartWatch</rdfs:label>
    <skos:definition xml:lang="en">A wrist-worn computing device with notifications, fitness tracking, and app support.</skos:definition>
    <rdfs:subClassOf rdf:resource="&ec;Electronics"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Accessories">
    <rdfs:label xml:lang="en">Accessories</rdfs:label>
    <skos:definition xml:lang="en">Supplementary non-primary items such as cables, cases, and chargers.</skos:definition>
    <rdfs:subClassOf rdf:resource="&ec;Product"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Cable">
    <rdfs:label xml:lang="en">Cable</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ec;Accessories"/>
    <skos:definition xml:lang="en">A connectivity cable (USB-C, Lightning, HDMI, etc.).</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="&ec;Charger">
    <rdfs:label xml:lang="en">Charger</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ec;Accessories"/>
    <skos:definition xml:lang="en">A power adapter or charging unit for electronic devices.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="&ec;Case">
    <rdfs:label xml:lang="en">Case</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ec;Accessories"/>
    <skos:definition xml:lang="en">A protective cover or enclosure for a device.</skos:definition>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Laptop"/>
      <rdf:Description rdf:about="&ec;Smartphone"/>
      <rdf:Description rdf:about="&ec;Tablet"/>
      <rdf:Description rdf:about="&ec;Headphones"/>
      <rdf:Description rdf:about="&ec;SmartWatch"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Electronics"/>
      <rdf:Description rdf:about="&ec;Accessories"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Cable"/>
      <rdf:Description rdf:about="&ec;Charger"/>
      <rdf:Description rdf:about="&ec;Case"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- ============================================================
       DEFINED (INFERRED) CLASSES - 10 total
       ============================================================ -->

  <!-- 1. PremiumProduct: price >= 1000 -->
  <owl:Class rdf:about="&ec;PremiumProduct">
    <rdfs:label xml:lang="en">PremiumProduct</rdfs:label>
    <skos:definition xml:lang="en">A product classified as premium because its price equals or exceeds $1,000 USD.</skos:definition>
    <ec:answersCompetencyQuestion>CQ1: Which products are premium?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;hasPrice"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="&xsd;decimal">1000.0</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 2. BudgetProduct: price < 300 -->
  <owl:Class rdf:about="&ec;BudgetProduct">
    <rdfs:label xml:lang="en">BudgetProduct</rdfs:label>
    <skos:definition xml:lang="en">A product priced below $300 USD targeting price-sensitive customers.</skos:definition>
    <ec:answersCompetencyQuestion>CQ13: Which products are budget-friendly?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;hasPrice"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxExclusive rdf:datatype="&xsd;decimal">300.0</xsd:maxExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 3. MidRangeProduct: 300 <= price < 1000 -->
  <owl:Class rdf:about="&ec;MidRangeProduct">
    <rdfs:label xml:lang="en">MidRangeProduct</rdfs:label>
    <skos:definition xml:lang="en">A product priced between $300 and $999 USD in the mid-market segment.</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;hasPrice"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="&xsd;decimal">300.0</xsd:minInclusive>
                  </rdf:Description>
                  <rdf:Description>
                    <xsd:maxExclusive rdf:datatype="&xsd;decimal">1000.0</xsd:maxExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 4. GamingLaptop: Laptop with isGamingLaptop = true -->
  <owl:Class rdf:about="&ec;GamingLaptop">
    <rdfs:label xml:lang="en">GamingLaptop</rdfs:label>
    <skos:definition xml:lang="en">A Laptop flagged as a gaming device (isGamingLaptop = true).</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Laptop"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;isGamingLaptop"/>
            <owl:hasValue rdf:datatype="&xsd;boolean">true</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 5. GamerCustomer: Customer who purchased a GamingLaptop -->
  <owl:Class rdf:about="&ec;GamerCustomer">
    <rdfs:label xml:lang="en">GamerCustomer</rdfs:label>
    <skos:definition xml:lang="en">A Customer who purchased at least one GamingLaptop.</skos:definition>
    <ec:answersCompetencyQuestion>CQ2: Which customers purchased a gaming laptop?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Customer"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;purchases"/>
            <owl:someValuesFrom rdf:resource="&ec;GamingLaptop"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 6. FrequentBuyer: Customer with orderCount >= 3 -->
  <owl:Class rdf:about="&ec;FrequentBuyer">
    <rdfs:label xml:lang="en">FrequentBuyer</rdfs:label>
    <skos:definition xml:lang="en">A Customer with three or more orders, eligible for loyalty programme benefits.</skos:definition>
    <ec:answersCompetencyQuestion>CQ11: Which customers qualify as frequent buyers?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Customer"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;hasOrderCount"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="&xsd;nonNegativeInteger"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="&xsd;nonNegativeInteger">3</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 7. LoyalCustomer: FrequentBuyer AND GamerCustomer -->
  <owl:Class rdf:about="&ec;LoyalCustomer">
    <rdfs:label xml:lang="en">LoyalCustomer</rdfs:label>
    <skos:definition xml:lang="en">A customer who is both a FrequentBuyer and a GamerCustomer - highest-value segment.</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;FrequentBuyer"/>
          <rdf:Description rdf:about="&ec;GamerCustomer"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 8. HighRatedProduct: aggregate rating >= 4.5 -->
  <owl:Class rdf:about="&ec;HighRatedProduct">
    <rdfs:label xml:lang="en">HighRatedProduct</rdfs:label>
    <skos:definition xml:lang="en">A product whose aggregate customer rating is 4.5 or above on a 5.0 scale.</skos:definition>
    <ec:answersCompetencyQuestion>CQ10: Which products have aggregate rating above 4.5?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;hasAggregateRating"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="&xsd;decimal">4.5</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 9. DiscountedProduct: discountPercentage > 0 -->
  <owl:Class rdf:about="&ec;DiscountedProduct">
    <rdfs:label xml:lang="en">DiscountedProduct</rdfs:label>
    <skos:definition xml:lang="en">A product currently offered at a reduced price (discount > 0%).</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;hasDiscountPercentage"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minExclusive rdf:datatype="&xsd;decimal">0.0</xsd:minExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- 10. VerifiedReview: Review with isVerifiedPurchase = true -->
  <owl:Class rdf:about="&ec;VerifiedReview">
    <rdfs:label xml:lang="en">VerifiedReview</rdfs:label>
    <skos:definition xml:lang="en">A Review confirmed as coming from a platform purchaser of the product.</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Review"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;isVerifiedPurchase"/>
            <owl:hasValue rdf:datatype="&xsd;boolean">true</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

