  <owl:NamedIndividual rdf:about="&ec;Cat_Audio">
    <rdf:type rdf:resource="&ec;Category"/>
    <rdfs:label xml:lang="en">Audio</rdfs:label>
    <ec:hasName>Audio</ec:hasName>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Cat_Wearables">
    <rdf:type rdf:resource="&ec;Category"/>
    <rdfs:label xml:lang="en">Wearables</rdfs:label>
    <ec:hasName>Wearables</ec:hasName>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Cat_Accessories">
    <rdf:type rdf:resource="&ec;Category"/>
    <rdfs:label xml:lang="en">Accessories</rdfs:label>
    <ec:hasName>Accessories</ec:hasName>
    <ec:hasSubcategory rdf:resource="&ec;Cat_Cables"/>
    <ec:hasSubcategory rdf:resource="&ec;Cat_Chargers"/>
    <ec:hasSubcategory rdf:resource="&ec;Cat_Cases"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Cat_Cables">
    <rdf:type rdf:resource="&ec;Category"/>
    <rdfs:label xml:lang="en">Cables</rdfs:label>
    <ec:hasName>Cables</ec:hasName>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Cat_Chargers">
    <rdf:type rdf:resource="&ec;Category"/>
