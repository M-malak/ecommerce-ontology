  <owl:NamedIndividual rdf:about="&ec;Cat_Tablets">
    <rdf:type rdf:resource="&ec;Category"/>
    <rdfs:label xml:lang="en">Tablets</rdfs:label>
    <ec:hasName>Tablets</ec:hasName>
