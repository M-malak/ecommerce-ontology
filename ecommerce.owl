    <ec:hasOrderID>ORD-002</ec:hasOrderID>
    <ec:hasOrderDate rdf:datatype="&xsd;date">2025-02-03</ec:hasOrderDate>
    <ec:hasTotalAmount rdf:datatype="&xsd;decimal">4797.00</ec:hasTotalAmount>
    <ec:hasDeliveryStatus>Delivered</ec:hasDeliveryStatus>
    <ec:containsProduct rdf:resource="&ec;MacBookPro"/>
    <ec:containsProduct rdf:resource="&ec;iPhone15Pro"/>
    <ec:containsProduct rdf:resource="&ec;iPadPro"/>
    <ec:usesPaymentMethod rdf:resource="&ec;PM_PayPal"/>
    <ec:isOrderOf rdf:resource="&ec;Customer_Sara"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Order003">
    <rdf:type rdf:resource="&ec;Order"/>
    <rdfs:label xml:lang="en">Order003</rdfs:label>
    <ec:hasOrderID>ORD-003</ec:hasOrderID>
    <ec:hasOrderDate rdf:datatype="&xsd;date">2025-03-10</ec:hasOrderDate>
    <ec:hasTotalAmount rdf:datatype="&xsd;decimal">954.00</ec:hasTotalAmount>
    <ec:hasDeliveryStatus>Delivered</ec:hasDeliveryStatus>
    <ec:containsProduct rdf:resource="&ec;GalaxyS24Ultra"/>
    <ec:containsProduct rdf:resource="&ec;AnkerCharger"/>
    <ec:usesPaymentMethod rdf:resource="&ec;PM_BankTransfer"/>
    <ec:isOrderOf rdf:resource="&ec;Customer_Omar"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Order004">
    <rdf:type rdf:resource="&ec;Order"/>
    <rdfs:label xml:lang="en">Order004</rdfs:label>
    <ec:hasOrderID>ORD-004</ec:hasOrderID>
    <ec:hasOrderDate rdf:datatype="&xsd;date">2025-03-22</ec:hasOrderDate>
    <ec:hasTotalAmount rdf:datatype="&xsd;decimal">897.00</ec:hasTotalAmount>
    <ec:hasDeliveryStatus>Delivered</ec:hasDeliveryStatus>
    <ec:containsProduct rdf:resource="&ec;SonyHeadphones"/>
    <ec:containsProduct rdf:resource="&ec;AppleWatch"/>
    <ec:containsProduct rdf:resource="&ec;iPhone15Case"/>
    <ec:usesPaymentMethod rdf:resource="&ec;PM_Mastercard"/>
    <ec:isOrderOf rdf:resource="&ec;Customer_Lena"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Order005">
    <rdf:type rdf:resource="&ec;Order"/>
    <rdfs:label xml:lang="en">Order005</rdfs:label>
    <ec:hasOrderID>ORD-005</ec:hasOrderID>
    <ec:hasOrderDate rdf:datatype="&xsd;date">2025-04-05</ec:hasOrderDate>
    <ec:hasTotalAmount rdf:datatype="&xsd;decimal">29.00</ec:hasTotalAmount>
    <ec:hasDeliveryStatus>Shipped</ec:hasDeliveryStatus>
    <ec:containsProduct rdf:resource="&ec;AppleUSBCCable"/>
    <ec:usesPaymentMethod rdf:resource="&ec;PM_Visa"/>
    <ec:isOrderOf rdf:resource="&ec;Customer_Ali"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Order006">
    <rdf:type rdf:resource="&ec;Order"/>
    <rdfs:label xml:lang="en">Order006</rdfs:label>
    <ec:hasOrderID>ORD-006</ec:hasOrderID>
    <ec:hasOrderDate rdf:datatype="&xsd;date">2025-04-18</ec:hasOrderDate>
    <ec:hasTotalAmount rdf:datatype="&xsd;decimal">2203.00</ec:hasTotalAmount>
    <ec:hasDeliveryStatus>Processing</ec:hasDeliveryStatus>
    <ec:containsProduct rdf:resource="&ec;ROGZephyrus"/>
    <ec:containsProduct rdf:resource="&ec;SonyHeadphones"/>
    <ec:containsProduct rdf:resource="&ec;AnkerCharger"/>
    <ec:usesPaymentMethod rdf:resource="&ec;PM_Bitcoin"/>
    <ec:isOrderOf rdf:resource="&ec;Customer_Riya"/>
  </owl:NamedIndividual>

  <owl:AllDifferent>
    <owl:distinctMembers rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Order001"/>
      <rdf:Description rdf:about="&ec;Order002"/>
      <rdf:Description rdf:about="&ec;Order003"/>
      <rdf:Description rdf:about="&ec;Order004"/>
      <rdf:Description rdf:about="&ec;Order005"/>
      <rdf:Description rdf:about="&ec;Order006"/>
    </owl:distinctMembers>
  </owl:AllDifferent>

  <!-- ============================================================
       REVIEW INDIVIDUALS (6, all VerifiedReview)
       ============================================================ -->

  <owl:NamedIndividual rdf:about="&ec;Review001">
    <rdf:type rdf:resource="&ec;Review"/>
    <rdfs:label xml:lang="en">Review001 - ROG Zephyrus by Ali</rdfs:label>
    <ec:hasRating rdf:datatype="&xsd;decimal">4.8</ec:hasRating>
    <ec:isVerifiedPurchase rdf:datatype="&xsd;boolean">true</ec:isVerifiedPurchase>
    <ec:hasReviewText xml:lang="en">Exceptional gaming performance across every AAA title. The 240 Hz OLED panel is transformative, and ROG thermal management keeps the chassis cool under sustained load. Build quality surpasses every Windows laptop I have owned.</ec:hasReviewText>
    <ec:reviewsProduct rdf:resource="&ec;ROGZephyrus"/>
    <ec:isWrittenBy rdf:resource="&ec;Customer_Ali"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Review002">
    <rdf:type rdf:resource="&ec;Review"/>
    <rdfs:label xml:lang="en">Review002 - MacBook Pro by Sara</rdfs:label>
    <ec:hasRating rdf:datatype="&xsd;decimal">4.9</ec:hasRating>
    <ec:isVerifiedPurchase rdf:datatype="&xsd;boolean">true</ec:isVerifiedPurchase>
    <ec:hasReviewText xml:lang="en">The M3 Max chip handles large RNA-seq datasets that previously required overnight runs. Compilation, data wrangling, and visualisation all complete in a fraction of the time. Battery remains strong under heavy computation. An indispensable research machine.</ec:hasReviewText>
    <ec:reviewsProduct rdf:resource="&ec;MacBookPro"/>
    <ec:isWrittenBy rdf:resource="&ec;Customer_Sara"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Review003">
    <rdf:type rdf:resource="&ec;Review"/>
    <rdfs:label xml:lang="en">Review003 - iPhone 15 Pro by Sara</rdfs:label>
    <ec:hasRating rdf:datatype="&xsd;decimal">4.7</ec:hasRating>
    <ec:isVerifiedPurchase rdf:datatype="&xsd;boolean">true</ec:isVerifiedPurchase>
    <ec:hasReviewText xml:lang="en">Titanium frame feels premium without adding weight. The camera system is excellent for scientific photo documentation. USB-C integration with the Mac workflow is seamless.</ec:hasReviewText>
    <ec:reviewsProduct rdf:resource="&ec;iPhone15Pro"/>
    <ec:isWrittenBy rdf:resource="&ec;Customer_Sara"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Review004">
    <rdf:type rdf:resource="&ec;Review"/>
    <rdfs:label xml:lang="en">Review004 - Galaxy S24 Ultra by Omar</rdfs:label>
    <ec:hasRating rdf:datatype="&xsd;decimal">4.6</ec:hasRating>
    <ec:isVerifiedPurchase rdf:datatype="&xsd;boolean">true</ec:isVerifiedPurchase>
    <ec:hasReviewText xml:lang="en">The 200 MP camera is stunning for landscape and macro work. S Pen integration is fluid and Galaxy AI features add real daily utility. Battery clears two days with moderate use.</ec:hasReviewText>
    <ec:reviewsProduct rdf:resource="&ec;GalaxyS24Ultra"/>
    <ec:isWrittenBy rdf:resource="&ec;Customer_Omar"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Review005">
    <rdf:type rdf:resource="&ec;Review"/>
    <rdfs:label xml:lang="en">Review005 - Sony WH-1000XM5 by Ali</rdfs:label>
    <ec:hasRating rdf:datatype="&xsd;decimal">4.7</ec:hasRating>
    <ec:isVerifiedPurchase rdf:datatype="&xsd;boolean">true</ec:isVerifiedPurchase>
    <ec:hasReviewText xml:lang="en">Best noise cancellation I have used on any headphone. Pairs effortlessly with the ROG laptop and phone simultaneously. Thirty hours battery is not a marketing claim; I verified it in practice.</ec:hasReviewText>
    <ec:reviewsProduct rdf:resource="&ec;SonyHeadphones"/>
    <ec:isWrittenBy rdf:resource="&ec;Customer_Ali"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Review006">
    <rdf:type rdf:resource="&ec;Review"/>
    <rdfs:label xml:lang="en">Review006 - Sony WH-1000XM5 by Lena</rdfs:label>
    <ec:hasRating rdf:datatype="&xsd;decimal">4.8</ec:hasRating>
    <ec:isVerifiedPurchase rdf:datatype="&xsd;boolean">true</ec:isVerifiedPurchase>
    <ec:hasReviewText xml:lang="en">Outstanding comfort for long-haul flights. Adaptive ANC adjusts perfectly to aircraft cabin pressure. Multipoint connection between laptop and phone holds without interruption.</ec:hasReviewText>
    <ec:reviewsProduct rdf:resource="&ec;SonyHeadphones"/>
    <ec:isWrittenBy rdf:resource="&ec;Customer_Lena"/>
  </owl:NamedIndividual>

  <owl:AllDifferent>
    <owl:distinctMembers rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Review001"/>
      <rdf:Description rdf:about="&ec;Review002"/>
      <rdf:Description rdf:about="&ec;Review003"/>
      <rdf:Description rdf:about="&ec;Review004"/>
      <rdf:Description rdf:about="&ec;Review005"/>
      <rdf:Description rdf:about="&ec;Review006"/>
    </owl:distinctMembers>
  </owl:AllDifferent>


  <!-- ============================================================
       FEATURE BLOCK A: InverseFunctionalProperty
       Semantics: no two distinct individuals share the same SKU,
       customerID, sellerID, or orderID value.
       ============================================================ -->

  <!-- hasSKU is also InverseFunctional: SKU uniquely identifies a product -->
  <owl:DatatypeProperty rdf:about="&ec;hasSKU">
    <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
    <rdfs:comment xml:lang="en">InverseFunctional: no two distinct products share the same SKU string.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasCustomerID">
    <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
    <rdfs:comment xml:lang="en">InverseFunctional: customer IDs are globally unique across the platform.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasOrderID">
    <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
    <rdfs:comment xml:lang="en">InverseFunctional: order IDs are globally unique transaction identifiers.</rdfs:comment>
  </owl:DatatypeProperty>


  <!-- ============================================================
       FEATURE BLOCK B: ReflexiveProperty
       Semantics: every product is compatible with itself
       (useful for recommendation engine — "also consider" self-link
       is suppressed at UI level but valid ontologically).
       ============================================================ -->

  <owl:ObjectProperty rdf:about="&ec;isCompatibleWith">
    <rdfs:label xml:lang="en">is compatible with</rdfs:label>
    <skos:definition xml:lang="en">Reflexive compatibility relation between products. Every product is trivially compatible with itself; non-trivial pairs represent confirmed accessory or software compatibility.</skos:definition>
    <skos:note xml:lang="en">ReflexiveProperty: the reasoner asserts isCompatibleWith(p, p) for every Product p automatically.</skos:note>
    <rdf:type rdf:resource="&owl;ReflexiveProperty"/>
    <rdf:type rdf:resource="&owl;SymmetricProperty"/>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&ec;Product"/>
  </owl:ObjectProperty>

  <!-- Assert explicit non-trivial compatibility pairs -->
  <owl:NamedIndividual rdf:about="&ec;MacBookPro">
    <ec:isCompatibleWith rdf:resource="&ec;AppleUSBCCable"/>
    <ec:isCompatibleWith rdf:resource="&ec;AnkerCharger"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;iPhone15Pro">
    <ec:isCompatibleWith rdf:resource="&ec;iPhone15Case"/>
    <ec:isCompatibleWith rdf:resource="&ec;AnkerCharger"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;ROGZephyrus">
    <ec:isCompatibleWith rdf:resource="&ec;AnkerCharger"/>
  </owl:NamedIndividual>


  <!-- ============================================================
       FEATURE BLOCK C: owl:disjointWith (pairwise, in addition to AllDisjointClasses)
       Semantics: explicit pairwise disjointness for Protege DL Query clarity.
       ============================================================ -->

  <owl:Class rdf:about="&ec;Customer">
    <owl:disjointWith rdf:resource="&ec;Seller"/>
    <owl:disjointWith rdf:resource="&ec;Brand"/>
    <owl:disjointWith rdf:resource="&ec;Product"/>
    <owl:disjointWith rdf:resource="&ec;Order"/>
    <owl:disjointWith rdf:resource="&ec;Review"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Product">
    <owl:disjointWith rdf:resource="&ec;Order"/>
    <owl:disjointWith rdf:resource="&ec;Review"/>
    <owl:disjointWith rdf:resource="&ec;Brand"/>
    <owl:disjointWith rdf:resource="&ec;Category"/>
  </owl:Class>

  <owl:Class rdf:about="&ec;Order">
    <owl:disjointWith rdf:resource="&ec;Review"/>
    <owl:disjointWith rdf:resource="&ec;Brand"/>
  </owl:Class>


  <!-- ============================================================
       FEATURE BLOCK D: SubPropertyOf (explicit hierarchy on object props)
       Semantics: purchases is a subproperty of interactsWith (broader);
       writesReview is a subproperty of interactsWith.
       ============================================================ -->

  <!-- interactsWith: broadest customer-entity relation -->
  <owl:ObjectProperty rdf:about="&ec;interactsWith">
    <rdfs:label xml:lang="en">interacts with</rdfs:label>
    <skos:definition xml:lang="en">Broadest customer-entity interaction. Purchases, order placement, and review authorship are all specialised forms of customer interaction.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&owl;Thing"/>
  </owl:ObjectProperty>

  <!-- purchases SubPropertyOf interactsWith -->
  <owl:ObjectProperty rdf:about="&ec;purchases">
    <rdfs:subPropertyOf rdf:resource="&ec;interactsWith"/>
  </owl:ObjectProperty>

  <!-- placesOrder SubPropertyOf interactsWith -->
  <owl:ObjectProperty rdf:about="&ec;placesOrder">
    <rdfs:subPropertyOf rdf:resource="&ec;interactsWith"/>
  </owl:ObjectProperty>

  <!-- writesReview SubPropertyOf interactsWith -->
  <owl:ObjectProperty rdf:about="&ec;writesReview">
    <rdfs:subPropertyOf rdf:resource="&ec;interactsWith"/>
  </owl:ObjectProperty>

  <!-- SubDataPropertyOf: hasPrice and hasOriginalPrice are both subproperties of hasMonetaryValue -->
  <owl:DatatypeProperty rdf:about="&ec;hasMonetaryValue">
    <rdfs:label xml:lang="en">has monetary value</rdfs:label>
    <skos:definition xml:lang="en">Abstract superProperty for any price-like monetary data property on a Product.</skos:definition>
    <rdfs:domain rdf:resource="&ec;Product"/>
    <rdfs:range rdf:resource="&xsd;decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasPrice">
    <rdfs:subPropertyOf rdf:resource="&ec;hasMonetaryValue"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasOriginalPrice">
    <rdfs:subPropertyOf rdf:resource="&ec;hasMonetaryValue"/>
  </owl:DatatypeProperty>


  <!-- ============================================================
       FEATURE BLOCK E: owl:complementOf
       Semantics: NonPremiumProduct = Product AND NOT PremiumProduct.
       ============================================================ -->

  <owl:Class rdf:about="&ec;NonPremiumProduct">
    <rdfs:label xml:lang="en">NonPremiumProduct</rdfs:label>
    <skos:definition xml:lang="en">Any Product that is NOT classified as a PremiumProduct (price below $1,000). Defined via complement of PremiumProduct within the Product class.</skos:definition>
    <ec:answersCompetencyQuestion>CQ14: Which products are not premium?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Product"/>
          <owl:Class>
            <owl:complementOf rdf:resource="&ec;PremiumProduct"/>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- UnverifiedReview = Review AND NOT VerifiedReview -->
  <owl:Class rdf:about="&ec;UnverifiedReview">
    <rdfs:label xml:lang="en">UnverifiedReview</rdfs:label>
    <skos:definition xml:lang="en">A Review that is NOT a VerifiedReview - the author's purchase of the product could not be confirmed by the platform.</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Review"/>
          <owl:Class>
            <owl:complementOf rdf:resource="&ec;VerifiedReview"/>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>


  <!-- ============================================================
       FEATURE BLOCK F: allValuesFrom (universal restriction)
       Semantics: AppleExclusiveProduct is a product whose manufacturer
       is ONLY Apple (all values of manufacturedBy are Apple).
       ============================================================ -->

  <owl:Class rdf:about="&ec;AppleExclusiveProduct">
    <rdfs:label xml:lang="en">AppleExclusiveProduct</rdfs:label>
    <skos:definition xml:lang="en">A Product for which every manufacturer assertion points to Apple Inc. Universal restriction ensures the class is non-trivially satisfied only by Apple-branded products.</skos:definition>
    <ec:answersCompetencyQuestion>CQ15: Which products are exclusively manufactured by Apple?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Product"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;manufacturedBy"/>
            <owl:allValuesFrom rdf:resource="&ec;Brand"/>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;manufacturedBy"/>
            <owl:hasValue rdf:resource="&ec;Apple"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- PlatformPayment: Order where ALL payment methods are digital (not BankTransfer) -->
  <owl:Class rdf:about="&ec;DigitalPaymentOrder">
    <rdfs:label xml:lang="en">DigitalPaymentOrder</rdfs:label>
    <skos:definition xml:lang="en">An Order whose payment method is universally restricted to non-bank-transfer digital instruments (CreditCard, PayPal, or CryptoCurrency).</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Order"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;usesPaymentMethod"/>
            <owl:allValuesFrom>
              <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                  <rdf:Description rdf:about="&ec;CreditCard"/>
                  <rdf:Description rdf:about="&ec;PayPal"/>
                  <rdf:Description rdf:about="&ec;CryptoCurrency"/>
                </owl:unionOf>
              </owl:Class>
            </owl:allValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>


  <!-- ============================================================
       FEATURE BLOCK G: maxQualifiedCardinality
       Semantics: SingleProductOrder has at most 1 product item.
       ============================================================ -->

  <owl:Class rdf:about="&ec;SingleProductOrder">
    <rdfs:label xml:lang="en">SingleProductOrder</rdfs:label>
    <skos:definition xml:lang="en">An Order containing exactly one Product - a single-item transaction. Defined by combining minQualifiedCardinality 1 with maxQualifiedCardinality 1.</skos:definition>
    <ec:answersCompetencyQuestion>CQ16: Which orders contain exactly one product?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Order"/>
          <!-- at least 1 -->
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;containsProduct"/>
            <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
            <owl:onClass rdf:resource="&ec;Product"/>
          </owl:Restriction>
          <!-- at most 1 -->
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;containsProduct"/>
            <owl:maxQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:maxQualifiedCardinality>
            <owl:onClass rdf:resource="&ec;Product"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- MultiProductOrder: at least 2 products -->
  <owl:Class rdf:about="&ec;MultiProductOrder">
    <rdfs:label xml:lang="en">MultiProductOrder</rdfs:label>
    <skos:definition xml:lang="en">An Order containing two or more distinct Products - a basket transaction.</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Order"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="&ec;containsProduct"/>
            <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">2</owl:minQualifiedCardinality>
            <owl:onClass rdf:resource="&ec;Product"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>


  <!-- ============================================================
       FEATURE BLOCK H: owl:disjointUnionOf (OWL 2 only)
       Semantics: Product is the disjoint union of Electronics and Accessories.
       Every product is either Electronics or Accessories (exhaustive),
       and nothing is both (disjoint). Covers the declared product universe.
       ============================================================ -->

  <owl:Class rdf:about="&ec;Product">
    <owl:disjointUnionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;Electronics"/>
      <rdf:Description rdf:about="&ec;Accessories"/>
    </owl:disjointUnionOf>
  </owl:Class>

  <!-- PaymentMethod is a disjoint union of all four payment types -->
  <owl:Class rdf:about="&ec;PaymentMethod">
    <owl:disjointUnionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;CreditCard"/>
      <rdf:Description rdf:about="&ec;PayPal"/>
      <rdf:Description rdf:about="&ec;BankTransfer"/>
      <rdf:Description rdf:about="&ec;CryptoCurrency"/>
    </owl:disjointUnionOf>
  </owl:Class>


  <!-- ============================================================
       FEATURE BLOCK I: Second and third property chain axioms
       Chain 2: placesOrder o containsProduct → indirectlyPurchases
         Semantics: if Customer places Order, and Order contains Product,
         the reasoner infers Customer indirectlyPurchases Product.
       Chain 3: writesReview o reviewsProduct → reviewedProduct
         Semantics: Customer writes Review about Product → Customer reviewedProduct Product
       ============================================================ -->

  <owl:ObjectProperty rdf:about="&ec;indirectlyPurchases">
    <rdfs:label xml:lang="en">indirectly purchases</rdfs:label>
    <skos:definition xml:lang="en">Inferred via chain: Customer placesOrder Order, Order containsProduct Product. Bridges the order-level and product-level purchase representations.</skos:definition>
    <skos:note xml:lang="en">Chain: placesOrder o containsProduct SubPropertyOf indirectlyPurchases</skos:note>
    <ec:answersCompetencyQuestion>CQ17: What products can be inferred as purchased via order records?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&ec;Product"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;placesOrder"/>
      <rdf:Description rdf:about="&ec;containsProduct"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;hasReviewedProduct">
    <rdfs:label xml:lang="en">has reviewed product</rdfs:label>
    <skos:definition xml:lang="en">Inferred via chain: Customer writesReview Review, Review reviewsProduct Product. Directly relates a Customer to products they have evaluated.</skos:definition>
    <skos:note xml:lang="en">Chain: writesReview o reviewsProduct SubPropertyOf hasReviewedProduct</skos:note>
    <ec:answersCompetencyQuestion>CQ18: Which products has a customer directly reviewed?</ec:answersCompetencyQuestion>
    <rdfs:domain rdf:resource="&ec;Customer"/>
    <rdfs:range rdf:resource="&ec;Product"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;writesReview"/>
      <rdf:Description rdf:about="&ec;reviewsProduct"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>


  <!-- ============================================================
       FEATURE BLOCK J: owl:hasKey (OWL 2 only)
       Semantics: Two Product individuals with the same hasSKU value
       must be the same individual. Keys enforce identity from data.
       ============================================================ -->

  <owl:Class rdf:about="&ec;Product">
    <owl:hasKey rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;hasSKU"/>
    </owl:hasKey>
  </owl:Class>

  <owl:Class rdf:about="&ec;Customer">
    <owl:hasKey rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;hasCustomerID"/>
    </owl:hasKey>
  </owl:Class>

  <owl:Class rdf:about="&ec;Order">
    <owl:hasKey rdf:parseType="Collection">
      <rdf:Description rdf:about="&ec;hasOrderID"/>
    </owl:hasKey>
  </owl:Class>


  <!-- ============================================================
       FEATURE BLOCK K: owl:NegativePropertyAssertion (OWL 2 only)
       Semantics: explicitly assert what is NOT true.
       ============================================================ -->

  <!-- Customer_Omar did NOT purchase MacBookPro (explicit closed-world assertion) -->
  <owl:NegativePropertyAssertion>
    <owl:sourceIndividual rdf:resource="&ec;Customer_Omar"/>
    <owl:assertionProperty rdf:resource="&ec;purchases"/>
    <owl:targetIndividual rdf:resource="&ec;MacBookPro"/>
  </owl:NegativePropertyAssertion>

  <!-- Customer_Lena did NOT place Order001 -->
  <owl:NegativePropertyAssertion>
    <owl:sourceIndividual rdf:resource="&ec;Customer_Lena"/>
    <owl:assertionProperty rdf:resource="&ec;placesOrder"/>
    <owl:targetIndividual rdf:resource="&ec;Order001"/>
  </owl:NegativePropertyAssertion>

  <!-- MacBookPro is NOT a gaming laptop (negative data assertion) -->
  <owl:NegativePropertyAssertion>
    <owl:sourceIndividual rdf:resource="&ec;MacBookPro"/>
    <owl:assertionProperty rdf:resource="&ec;isGamingLaptop"/>
    <owl:targetValue rdf:datatype="&xsd;boolean">true</owl:targetValue>
  </owl:NegativePropertyAssertion>

  <!-- GalaxyS24Ultra is NOT manufactured by Apple -->
  <owl:NegativePropertyAssertion>
    <owl:sourceIndividual rdf:resource="&ec;GalaxyS24Ultra"/>
    <owl:assertionProperty rdf:resource="&ec;manufacturedBy"/>
    <owl:targetIndividual rdf:resource="&ec;Apple"/>
  </owl:NegativePropertyAssertion>


  <!-- ============================================================
       FEATURE BLOCK L: owl:differentFrom (pairwise, beyond AllDifferent)
       Adds explicit pairwise distinctions for key cross-group pairs.
       ============================================================ -->

  <owl:NamedIndividual rdf:about="&ec;Apple">
    <owl:differentFrom rdf:resource="&ec;Customer_Ali"/>
    <owl:differentFrom rdf:resource="&ec;Seller_TechZone"/>
    <owl:differentFrom rdf:resource="&ec;MacBookPro"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;Seller_TechZone">
    <owl:differentFrom rdf:resource="&ec;Customer_Ali"/>
    <owl:differentFrom rdf:resource="&ec;Customer_Sara"/>
    <owl:differentFrom rdf:resource="&ec;Customer_Omar"/>
  </owl:NamedIndividual>


  <!-- ============================================================
       FEATURE BLOCK M: owl:sameAs
       Semantics: ROGZephyrus is the same individual as
       ROGZephyrusG16 (an alias IRI used in an external catalogue).
       ============================================================ -->

  <owl:NamedIndividual rdf:about="&ec;ROGZephyrusG16_Alias">
    <rdfs:label xml:lang="en">ROG Zephyrus G16 (Alias)</rdfs:label>
    <rdfs:comment xml:lang="en">External catalogue IRI alias for ROGZephyrus. owl:sameAs asserts these two IRIs denote the same product individual.</rdfs:comment>
    <owl:sameAs rdf:resource="&ec;ROGZephyrus"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="&ec;AppleWatchSeries9_Alias">
    <rdfs:label xml:lang="en">Apple Watch Series 9 (Retailer Alias)</rdfs:label>
    <rdfs:comment xml:lang="en">Retailer catalogue alias for AppleWatch. Demonstrates owl:sameAs for identity merging across catalogue sources.</rdfs:comment>
    <owl:sameAs rdf:resource="&ec;AppleWatch"/>
  </owl:NamedIndividual>


  <!-- ============================================================
       FEATURE BLOCK N: DataOneOf (enumerated data range)
       Semantics: hasDeliveryStatus is restricted to a closed
       enumeration of string values.
       ============================================================ -->

  <owl:DatatypeProperty rdf:about="&ec;hasDeliveryStatus">
    <rdfs:range>
      <rdfs:Datatype>
        <owl:oneOf>
          <rdf:Description>
            <rdf:first rdf:datatype="&xsd;string">Processing</rdf:first>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:datatype="&xsd;string">Shipped</rdf:first>
                <rdf:rest>
                  <rdf:Description>
                    <rdf:first rdf:datatype="&xsd;string">Delivered</rdf:first>
                    <rdf:rest>
                      <rdf:Description>
                        <rdf:first rdf:datatype="&xsd;string">Cancelled</rdf:first>
                        <rdf:rest>
                          <rdf:Description>
                            <rdf:first rdf:datatype="&xsd;string">Returned</rdf:first>
                            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          </rdf:Description>
                        </rdf:rest>
                      </rdf:Description>
                    </rdf:rest>
                  </rdf:Description>
                </rdf:rest>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:oneOf>
      </rdfs:Datatype>
    </rdfs:range>
  </owl:DatatypeProperty>


  <!-- ============================================================
       FEATURE BLOCK O: owl:oneOf (enumerated individual class)
       Semantics: PlatformBrand is exactly the set of five known brands.
       ============================================================ -->

  <owl:Class rdf:about="&ec;PlatformBrand">
    <rdfs:label xml:lang="en">PlatformBrand</rdfs:label>
    <skos:definition xml:lang="en">The closed enumeration of brands currently active on the platform. Any new brand must be explicitly added to this set.</skos:definition>
    <ec:answersCompetencyQuestion>CQ19: Which brands are registered on this platform?</ec:answersCompetencyQuestion>
    <owl:equivalentClass>
      <owl:Class>
        <owl:oneOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Apple"/>
          <rdf:Description rdf:about="&ec;Samsung"/>
          <rdf:Description rdf:about="&ec;Asus"/>
          <rdf:Description rdf:about="&ec;Sony"/>
          <rdf:Description rdf:about="&ec;Anker"/>
        </owl:oneOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- PlatformSeller: closed enumeration of registered sellers -->
  <owl:Class rdf:about="&ec;PlatformSeller">
    <rdfs:label xml:lang="en">PlatformSeller</rdfs:label>
    <skos:definition xml:lang="en">The closed enumeration of sellers registered on the platform.</skos:definition>
    <owl:equivalentClass>
      <owl:Class>
        <owl:oneOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&ec;Seller_TechZone"/>
          <rdf:Description rdf:about="&ec;Seller_GadgetHub"/>
        </owl:oneOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>


  <!-- ============================================================
       FEATURE BLOCK P: owl:deprecated (annotation on obsolete elements)
       Marks a property that has been superseded.
       ============================================================ -->

  <!-- hasDescription is deprecated in favour of rdfs:comment for literals -->
  <owl:DatatypeProperty rdf:about="&ec;hasDescription">
    <owl:deprecated rdf:datatype="&xsd;boolean">true</owl:deprecated>
    <rdfs:comment xml:lang="en">Deprecated since v2.0. Use rdfs:comment for free-text descriptions. Retained for backward compatibility with v1.x consumers.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  </owl:DatatypeProperty>


  <!-- ============================================================
       FEATURE BLOCK Q: rdfs:seeAlso on properties (cross-references)
       ============================================================ -->

  <owl:ObjectProperty rdf:about="&ec;purchases">
    <rdfs:seeAlso rdf:resource="http://schema.org/buyer"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/goodrelations/v1#buys"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;sells">
    <rdfs:seeAlso rdf:resource="http://schema.org/seller"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/goodrelations/v1#sells"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasPrice">
    <rdfs:seeAlso rdf:resource="http://schema.org/price"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/goodrelations/v1#hasCurrencyValue"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ec;hasAggregateRating">
    <rdfs:seeAlso rdf:resource="http://schema.org/ratingValue"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="&ec;manufacturedBy">
    <rdfs:seeAlso rdf:resource="http://schema.org/manufacturer"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/goodrelations/v1#hasMakeAndModel"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ec;belongsToCategory">
    <rdfs:seeAlso rdf:resource="http://schema.org/category"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/goodrelations/v1#category"/>
  </owl:ObjectProperty>


  <!-- ============================================================
       FEATURE BLOCK R: Additional SubObjectPropertyOf (explicit)
       sells SubPropertyOf interactsWith (Seller extends to broader domain)
       hasRelatedProduct SubPropertyOf isCompatibleWith
       ============================================================ -->

  <owl:ObjectProperty rdf:about="&ec;hasRelatedProduct">
    <rdfs:subPropertyOf rdf:resource="&ec;isCompatibleWith"/>
    <rdfs:comment xml:lang="en">hasRelatedProduct is a subproperty of isCompatibleWith: all related products are at minimum compatible, but not all compatible products are marketed as related.</rdfs:comment>
  </owl:ObjectProperty>

</rdf:RDF>

